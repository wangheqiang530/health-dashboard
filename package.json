    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:raw-import": "tsx scripts/test_import_pipeline.ts",
    "import:apple-health": "tsx scripts/import_apple_health_file.ts",
    "import:hae": "tsx scripts/import_hae_file.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "restore:db": "node scripts/restore_db.mjs",
    "export:history": "node scripts/export_codex_history.mjs"
  },
  "dependencies": {
    "@emmorts/body-muscles": "2.1.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@garmin/fitsdk": "21.218.0",
    "@tailwindcss/vite": "^4.3.3",
    "adm-zip": "^0.6.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "framer-motion": "^14.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.58.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "proxy-agent": "^8.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
